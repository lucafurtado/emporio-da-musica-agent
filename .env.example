# Copie este arquivo para ".env" e preencha com sua própria chave.
# Nunca commite o arquivo ".env" de verdade (ele já está no .gitignore).

ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Opcional - troca o modelo usado pelo agente sem mexer no código.
# Ver README para a justificativa da escolha do modelo padrão.
ANTHROPIC_MODEL=claude-haiku-5-5
